; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deskmica"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=30
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://scripts/core/signal_bus.gd"
DataRegistry="*res://scripts/core/data_registry.gd"
SaveManager="*res://scripts/core/save_manager.gd"
EconomyManager="*res://scripts/simulation/economy_manager.gd"
TokenManager="*res://scripts/simulation/token_manager.gd"
BuffManager="*res://scripts/simulation/buff_manager.gd"
TaskManager="*res://scripts/simulation/task_manager.gd"
MainLoopManager="*res://scripts/core/main_loop_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
